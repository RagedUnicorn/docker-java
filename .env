# Default Java image versions (used by docker-compose.yml and the examples).
# docker-compose.test.yml reads JAVA_JDK_TEST_VERSION / JAVA_JRE_TEST_VERSION
# instead (defaulting to test-jdk / test-jre), so these never redirect the
# tests to the published images.
JAVA_JDK_VERSION=latest
JAVA_JRE_VERSION=latest-jre

# Container structure test harness version (used by docker-compose.test.yml).
# Pinned so CI validates against a known harness; Renovate proposes bumps.
# renovate: datasource=docker depName=ragedunicorn/container-test
CONTAINER_STRUCTURE_TEST_VERSION=1.22.1-alpine3.24.1-1
